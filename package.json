{
  "name": "svelte-bricks",
  "version": "0.5.0",
  "description": "Svelte masonry component with SSR support and column balancing",
  "keywords": [
    "component",
    "masonry",
    "pinterest-layout",
    "svelte"
  ],
  "homepage": "https://janosh.github.io/svelte-bricks",
  "bugs": "https://github.com/janosh/svelte-bricks/issues",
  "license": "MIT",
  "author": "Janosh Riebesell <janosh.riebesell@gmail.com>",
  "repository": "https://github.com/janosh/svelte-bricks",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    "./Masonry.svelte": {
      "types": "./dist/Masonry.svelte.d.ts",
      "svelte": "./dist/Masonry.svelte",
      "default": "./dist/Masonry.svelte"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vp test --run && playwright test",
    "package": "svelte-package",
    "prepublishOnly": "npm run package"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "^7.0.0-dev.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@wooorm/starry-night": "^3.9.0",
    "abstract-syntax-tree": "^2.22.0",
    "acorn": "^8.16.0",
    "happy-dom": "^20.9.0",
    "mdsvex": "^0.12.7",
    "svelte": "^5.55.5",
    "svelte-check-rs": "^0.9.7",
    "svelte-multiselect": "^11.7.0",
    "svelte-preprocess": "^6.0.3",
    "svelte-toc": "^0.6.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "pnpm": {
    "overrides": {
      "svelte": "$svelte",
      "vite": "$vite",
      "vitest": "$vitest"
    }
  }
}
