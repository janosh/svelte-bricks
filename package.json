{
  "name": "svelte-bricks",
  "version": "0.5.0",
  "description": "Svelte masonry component with SSR support and column balancing",
  "keywords": [
    "component",
    "masonry",
    "pinterest-layout",
    "svelte"
  ],
  "homepage": "https://janosh.github.io/svelte-bricks",
  "bugs": "https://github.com/janosh/svelte-bricks/issues",
  "license": "MIT",
  "author": "Janosh Riebesell <janosh.riebesell@gmail.com>",
  "repository": "https://github.com/janosh/svelte-bricks",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    "./Masonry.svelte": {
      "types": "./dist/Masonry.svelte.d.ts",
      "svelte": "./dist/Masonry.svelte",
      "default": "./dist/Masonry.svelte"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vp test --run && playwright test",
    "package": "svelte-package",
    "prepublishOnly": "npm run package"
  },
  "devDependencies": {
    "@janosh/vite-config": "github:janosh/dotfiles",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.9.3",
    "@typescript/native-preview": "7.0.0-dev.20260611.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@wooorm/starry-night": "^3.10.0",
    "abstract-syntax-tree": "^2.22.0",
    "acorn": "^8.17.0",
    "happy-dom": "^20.10.2",
    "mdsvex": "^0.12.7",
    "svelte": "^5.56.3",
    "svelte-check-rs": "^0.10.1",
    "svelte-multiselect": "^11.7.2",
    "svelte-toc": "^0.7.0",
    "vite": "^8.0.16",
    "vite-plus": "latest",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "packageManager": "pnpm@11.5.0"
}
